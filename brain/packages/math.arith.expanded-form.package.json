    {
      "assetId": "math.arith.expanded-form/learning_objective/1",
      "kind": "learning_objective",
      "conceptId": "math.arith.expanded-form",
      "title": "Learning Objectives",
      "content": "- LO1: Write any given multi-digit whole number in expanded form (sum of each digit times its place value).\n- LO2: Reconstruct the standard (compact) form of a number from its expanded form.\n- LO3: Correctly handle a zero digit in expanded form — recognizing it contributes nothing to the sum, without introducing a spurious \"0\" term or skipping the place value entirely.",
      "localKey": null,
      "language": "en",
