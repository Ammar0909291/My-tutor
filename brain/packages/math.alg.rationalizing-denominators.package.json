  "assets": [
    {
      "assetId": "math.alg.rationalizing-denominators/learning_objective/1",
      "kind": "learning_objective",
      "conceptId": "math.alg.rationalizing-denominators",
      "title": "Learning Objectives",
      "content": "- LO1: Rationalize a denominator containing a SINGLE radical term by multiplying numerator and denominator by that SAME radical.\n- LO2: Rationalize a denominator containing a BINOMIAL with a radical (e.g. $a+\\sqrt b$) by multiplying numerator and denominator by its CONJUGATE ($a-\\sqrt b$), using the difference-of-squares pattern to eliminate the radical.\n- LO3: Recognize that multiplying by \"the same thing over itself\" (radical/radical or conjugate/conjugate) is equivalent to multiplying by 1, preserving the fraction's value while changing its FORM.",
      "localKey": null,
      "language": "en",
