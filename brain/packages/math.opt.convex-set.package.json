  "assets": [
    {
      "assetId": "math.opt.convex-set/learning_objective/1",
      "kind": "learning_objective",
      "conceptId": "math.opt.convex-set",
      "title": "Learning Objective",
      "content": "Given a subset S of ℝⁿ, the student applies the line-segment criterion (for all x,y∈S and t∈[0,1], tx+(1−t)y∈S) to classify S as convex or non-convex, identifies canonical convex sets (balls, half-spaces, hyperplanes, polyhedra, cones), explains why convexity is closed under intersection and affine maps, and distinguishes convex from non-convex regions by counterexample.",
      "localKey": null,
      "language": "en",
      "refs": [],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.convex-set.md",
        "startLine": 18,
        "endLine": 21
      }
    },
    {
      "assetId": "math.opt.convex-set/misconception/MC-1",
      "kind": "misconception",
      "conceptId": "math.opt.convex-set",
      "title": "CONVEX-MEANS-SMOOTH",
      "content": "| MC-1 | CONVEX-MEANS-SMOOTH | Student conflates convexity with smoothness of boundary; believes a square (with corners) is not convex | Type 2 — perceptual intuition (smooth curves look \"more convex\") |",
      "localKey": "MC-1",
      "language": "en",
      "refs": [
        "MC-1"
      ],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.convex-set.md",
        "startLine": 28,
