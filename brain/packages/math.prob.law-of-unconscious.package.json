    {
      "assetId": "math.prob.law-of-unconscious/teaching_action_meta/TA-6",
      "kind": "teaching_action_meta",
      "conceptId": "math.prob.law-of-unconscious",
      "title": "PARTIAL → \"LOTUS means you compute E[g(X)] directly from the distribution of X. You don't need the distribution of Y=g(X). Example: E[X²] — just weight x² by P(X=x), not by P(X²=y) (which would be the hard route).\" → TB-R01 → A02",
      "content": "{\"id\":\"TA-6\",\"title\":\"PARTIAL → \\\"LOTUS means you compute E[g(X)] directly from the distribution of X. You don't need the distribution of Y=g(X). Example: E[X²] — just weight x² by P(X=x), not by P(X²=y) (which would be the hard route).\\\" → TB-R01 → A02\",\"primitives\":[],\"addresses\":[]}",
      "localKey": "TA-6",
      "language": "en",
      "refs": [],
      "span": {
        "file": "docs/curriculum/blueprints/math.prob.law-of-unconscious.md",
