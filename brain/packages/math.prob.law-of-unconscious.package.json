      "kind": "teaching_action_meta",
      "conceptId": "math.prob.law-of-unconscious",
      "title": "INCORRECT → TB-R01 → A02",
      "content": "{\"id\":\"TA-7\",\"title\":\"INCORRECT → TB-R01 → A02\",\"primitives\":[],\"addresses\":[]}",
      "localKey": "TA-7",
      "language": "en",
