    {
      "assetId": "math.prob.law-of-unconscious/teaching_action_meta/TA-8",
      "kind": "teaching_action_meta",
      "conceptId": "math.prob.law-of-unconscious",
      "title": "NO_RESPONSE → \"X~Geometric(p). E[X]=(1−p)/p? Actually E[X]=1/p for standard geometric. Compute E[X(X−1)] directly: E[X(X−1)]=∑_{k=1}^{∞} k(k−1)(1−p)^{k-1}p. This is the 'hard route' for the second moment. LOTUS says: compute ∑_{k=0}^{∞} k(k−1) P(X=k). Can you see this is the same sum?\" → TB-R01 → A02",
      "content": "{\"id\":\"TA-8\",\"title\":\"NO_RESPONSE → \\\"X~Geometric(p). E[X]=(1−p)/p? Actually E[X]=1/p for standard geometric. Compute E[X(X−1)] directly: E[X(X−1)]=∑_{k=1}^{∞} k(k−1)(1−p)^{k-1}p. This is the 'hard route' for the second moment. LOTUS says: compute ∑_{k=0}^{∞} k(k−1) P(X=k). Can you see this is the same sum?\\\" → TB-R01 → A02\",\"primitives\":[],\"addresses\":[]}",
      "localKey": "TA-8",
      "language": "en",
      "refs": [],
      "span": {
        "file": "docs/curriculum/blueprints/math.prob.law-of-unconscious.md",
        "startLine": 60,
        "endLine": 60
      }
    },
