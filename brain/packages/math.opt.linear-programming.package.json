  "assets": [
    {
      "assetId": "math.opt.linear-programming/learning_objective/1",
      "kind": "learning_objective",
      "conceptId": "math.opt.linear-programming",
      "title": "Learning Objective",
      "content": "Given a linear program in standard form (min cᵀx s.t. Ax=b, x≥0), the student identifies the feasible polytope, states that the optimal solution occurs at a vertex (basic feasible solution), executes two iterations of the simplex method (pivot selection and basis update), formulates the dual LP and applies LP duality (weak and strong duality, complementary slackness), and selects between simplex and interior-point methods by problem structure.",
      "localKey": null,
      "language": "en",
      "refs": [],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.linear-programming.md",
        "startLine": 18,
        "endLine": 21
      }
    },
    {
      "assetId": "math.opt.linear-programming/misconception/MC-1",
      "kind": "misconception",
      "conceptId": "math.opt.linear-programming",
      "title": "OPTIMAL-INTERIOR-LP",
      "content": "| MC-1 | OPTIMAL-INTERIOR-LP | Student believes the LP optimum can occur in the interior of the feasible polytope; does not know the extreme-point (vertex) theorem | Type 2 — perceptual intuition (smooth optimisation finds interior optima; LP looks the same) |",
      "localKey": "MC-1",
      "language": "en",
      "refs": [
        "MC-1"
      ],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.linear-programming.md",
        "startLine": 28,
        "endLine": 28
      }
    },
    {
      "assetId": "math.opt.linear-programming/misconception/MC-2",
      "kind": "misconception",
      "conceptId": "math.opt.linear-programming",
      "title": "DUAL-ALWAYS-EQUALS-PRIMAL",
      "content": "| MC-2 | DUAL-ALWAYS-EQUALS-PRIMAL | Student applies strong duality unconditionally; does not check whether both primal and dual are feasible (strong duality fails if primal is infeasible or unbounded) | Type 5 — instruction-induced (\"LP duality\" is taught as strong duality; caveats are added later) |",
      "localKey": "MC-2",
      "language": "en",
      "refs": [
        "MC-2"
      ],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.linear-programming.md",
        "startLine": 29,
        "endLine": 29
      }
    },
    {
      "assetId": "math.opt.linear-programming/misconception/MC-3",
      "kind": "misconception",
      "conceptId": "math.opt.linear-programming",
      "title": "SIMPLEX-EXPONENTIAL-IN-PRACTICE",
      "content": "| MC-3 | SIMPLEX-EXPONENTIAL-IN-PRACTICE | Student dismisses simplex as exponential-time and therefore impractical; does not know that simplex runs in polynomial expected time and dominates interior-point for sparse/warm-started problems | Type 3 — language contamination (worst-case exponential ≠ typical exponential; courses often emphasise worst case) |",
      "localKey": "MC-3",
      "language": "en",
      "refs": [
        "MC-3"
      ],
      "span": {
        "file": "docs/curriculum/blueprints/math.opt.linear-programming.md",
        "startLine": 30,
        "endLine": 30
      }
